# Copy this file to `.env` and fill in real values.
# Never commit `.env` — the platform injects these variables in preview/production automatically.

# --- Client-visible (safe to ship in the browser bundle) ---
# Piston API key: obtain from https://github.com/engineer-man/piston (required since Feb 2026)
VITE_PISTON_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Google Search Console Verification (optional)
VITE_GOOGLE_SITE_VERIFICATION=

# --- Server-only (Cloudflare Worker; never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

